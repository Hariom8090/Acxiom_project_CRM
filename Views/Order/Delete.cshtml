@{
}
@model Acxiom73.Models.Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-danger text-white rounded-top-4 text-center">
                    <h3 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Order</h3>
                </div>
                <div class="card-body p-4">
                    <h5 class="text-center text-danger mb-4">Are you sure you want to delete this order?</h5>

                    <ul class="list-group mb-4">
                        <li class="list-group-item"><strong>ID:</strong> @Model.Id</li>
                        <li class="list-group-item"><strong>Customer Name:</strong> @Model.CustomerName</li>
                        <li class="list-group-item"><strong>Order Date:</strong> @Model.OrderDate.ToShortDateString()</li>
                        <li class="list-group-item"><strong>Quantity:</strong> @Model.Quantity</li>
                        <li class="list-group-item"><strong>Price:</strong> @Model.Price.ToString("C")</li>
                        <li class="list-group-item"><strong>Total:</strong> @Model.Total.ToString("C")</li>
                    </ul>

                    <div class="d-flex justify-content-between">
                        <form method="post">
                            <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                                <i class="bi bi-trash-fill me-2"></i>Confirm Delete
                            </button>
                        </form>
                        <a href="/Order" class="btn btn-secondary btn-lg shadow-sm">
                            <i class="bi bi-arrow-left-circle me-2"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Bootstrap validation scripts if needed -->
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
