@{
}
@model Acxiom73.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-primary text-white rounded-top-4 text-center">
                    <h3 class="mb-0"><i class="bi bi-info-circle-fill me-2"></i>Order Details</h3>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item"><strong>ID:</strong> @Model.Id</li>
                        <li class="list-group-item"><strong>Customer Name:</strong> @Model.CustomerName</li>
                        <li class="list-group-item"><strong>Order Date:</strong> @Model.OrderDate.ToShortDateString()</li>
                        <li class="list-group-item"><strong>Quantity:</strong> @Model.Quantity</li>
                        <li class="list-group-item"><strong>Price:</strong> @Model.Price.ToString("C")</li>
                        <li class="list-group-item"><strong>Total:</strong> @Model.Total.ToString("C")</li>
                    </ul>

                    <div class="d-flex justify-content-between">
                        <a href="/Order" class="btn btn-secondary btn-lg shadow-sm">
                            <i class="bi bi-arrow-left-circle me-2"></i>Back to List
                        </a>
                        <a href="/Order/Edit/@Model.Id" class="btn btn-warning btn-lg shadow-sm">
                            <i class="bi bi-pencil-square me-2"></i>Edit
                        </a>
                        <a href="/Order/Delete/@Model.Id" class="btn btn-danger btn-lg shadow-sm">
                            <i class="bi bi-trash-fill me-2"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Bootstrap icons if needed -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
}
