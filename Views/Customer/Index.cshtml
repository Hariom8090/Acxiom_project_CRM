@model IEnumerable<Acxiom73.Models.Customer>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .page-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .table-container {
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    .custom-btn-add {
        background: linear-gradient(90deg, #007bff, #00c6ff);
        border: none;
        padding: 8px 18px;
        color: white;
        border-radius: 6px;
        font-weight: bold;
        transition: 0.3s;
    }

        .custom-btn-add:hover {
            opacity: .8;
        }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-active {
        background: #d4edda;
        color: #155724;
    }

    .status-inactive {
        background: #f8d7da;
        color: #721c24;
    }

    .action-btn {
        width: 70px;
    }
</style>


<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">Customer List</h2>

    <a class="custom-btn-add" href="/Customer/Create">
        ➕ Add New
    </a>
</div>


<div class="table-container">

    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Full Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Address</th>
                <th>Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Phone</td>
                    <td>@item.Email</td>
                    <td>@item.Address</td>
                    <td>
                        @if (item.Status == "Active")
                        {
                            <span class="status-badge status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">Inactive</span>
                        }
                    </td>

                    <td class="text-center">
                        <a class="btn btn-warning btn-sm action-btn" href="/Customer/Edit/@item.Id">Edit</a>
                        <a class="btn btn-danger btn-sm action-btn" href="/Customer/Delete/@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="mt-4 d-flex justify-content-between">
        
        <a href="/Main/Dasbord" class="btn btn-secondary btn-back">⬅ Back</a>
    </div>

</div>
