@model Acxiom73.Models.Customer

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .delete-card {
        max-width: 500px;
        margin: 60px auto;
        padding: 30px 35px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 5px 25px rgba(0,0,0,0.1);
        text-align: center;
    }

    .delete-title {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #d9534f;
    }

    .customer-details {
        font-size: 16px;
        color: #555;
        margin-bottom: 25px;
        text-align: left;
    }

        .customer-details strong {
            font-weight: 600;
            color: #333;
        }

    .btn-confirm {
        background: linear-gradient(90deg, #d9534f, #ff5c5c);
        border: none;
        padding: 10px 25px;
        font-weight: bold;
        border-radius: 8px;
        color: white;
        transition: 0.3s;
    }

        .btn-confirm:hover {
            opacity: 0.9;
        }

    .btn-cancel {
        border-radius: 8px;
        padding: 10px 25px;
        font-weight: bold;
        margin-left: 10px;
    }
</style>

<div class="delete-card">
    <h2 class="delete-title">Delete Customer</h2>

    <h5>Are you sure you want to delete this customer?</h5>

    <div class="customer-details mt-3">
        <p><strong>@Model.FullName</strong></p>
        <p>📞 Phone: @Model.Phone</p>
        <p>✉ Email: @Model.Email</p>
        <p>🏠 Address: @Model.Address</p>
        <p>Status: @Model.Status</p>
    </div>

    <form method="post">
        <button type="submit" class="btn btn-confirm">Confirm Delete</button>
        <a href="/Customer" class="btn btn-secondary btn-cancel">Cancel</a>
    </form>
</div>
