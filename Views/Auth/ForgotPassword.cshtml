@{
}
@{
    ViewBag.Title = "Forgot Password";
}
<body style="background-image:url('/image/ERP4.jpg.png');background-size:cover;position:center">
<div class="d-flex justify-content-center align-items-center" style="height: 88vh;">
    <div class="card shadow p-4" style="width: 380px;">

        <h3 class="text-center mb-3" style="font-weight:600;">Forgot Password</h3>
        <p class="text-muted text-center mb-4">Enter your registered email to reset your password</p>

        <form method="post">
            <div class="mb-3">
                <label class="form-label" style="font-weight:500;">Email Address</label>
                <input type="email" name="email" class="form-control form-control-lg" placeholder="example@gmail.com" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">
                Send Reset Link
            </button>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 text-center">
                    @ViewBag.Error
                </div>
            }
        </form>

        <div class="text-center mt-3">
            <a href="/Auth/Login" class="text-decoration-none">Back to Login</a>
        </div>
    </div>
</div>
</body>